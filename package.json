{
  "name": "dsh-turn-game",
  "version": "0.1.0",
  "description": "Turn-based game interface for DeepSeek Harness: bind a session, receive turns from any game through a generic Turn Gateway.",
  "license": "MIT",
  "author": "大肥鱼 (DeepSeek Harness AI)",
  "type": "module",
  "main": "lib/index.js",
  "icon": "icon.svg",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "icon.svg"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "turn-based",
    "turn-protocol",
    "game-interface",
    "multi-game",
    "game",
    "gomoku",
    "agent",
    "activation"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/pineapple182/dsh-turn-game.git"
  },
  "homepage": "https://github.com/pineapple182/dsh-turn-game#readme",
  "bugs": {
    "url": "https://github.com/pineapple182/dsh-turn-game/issues"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.0-rc.1 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-llm": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-tools": "^0.2.0-rc.1",
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "scripts": {
    "test": "node test/package.test.mjs && node test/gateway-client.test.mjs && node test/activation-controller.test.mjs && node test/host.test.mjs"
  }
}
